{
  "name": "layerforge-vst3",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "description": "LayerForge - Multi-Layer Drum Designer, Transient Shaper & Clipper VST3/AU Instrument",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "vite",
    "lint": "eslint .",
    "lint:native": "clang-format --dry-run --Werror native/PluginClipboard_win.cpp native/PluginClipboard.h native/PluginClipboard_mac.mm",
    "lint:shell": "shellcheck scripts/*.sh",
    "check:release": "node scripts/check-release.mjs",
    "test": "node --test test/waveform.test.js test/release.test.js",
    "check": "npm run lint && npm test",
    "prebuild:ui": "npm run check",
    "build:ui": "vite build",
    "prebuild:native": "npm run check && node scripts/build-native-graph.mjs",
    "build:native": "cmake -B native/build -S native -DCMAKE_BUILD_TYPE=Release && cmake --build native/build --config Release -j",
    "install:vst3": "bash scripts/install-vst3.sh",
    "sign:mac": "codesign --force --deep --sign - ~/Library/Audio/Plug-Ins/VST3/LayerForge.vst3 && codesign --force --deep --sign - ~/Library/Audio/Plug-Ins/Components/LayerForge.component",
    "build": "npm run build:ui && npm run build:native"
  },
  "dependencies": {
    "@elemaudio/core": "^4.0.1",
    "@elemaudio/offline-renderer": "^4.0.3",
    "@elemaudio/web-renderer": "^4.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "vite": "^8.3.8"
  }
}
